runs/stage3/judge/full_qwen3.8-27b/predictions.jsonl

# Registro incremental del juez: copia de trabajo de predictions.jsonl (mismo contenido al terminar).
runs/stage3/judge/*/predictions.progress.jsonl

# Respaldos locales de planillas tomados antes de editarlas a mano (no son datos del experimento).
data/stage3/annotation/*.backup.csv
